e:Tda3,{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "ESTA for Israel Citizens",
  "description": "Complete ESTA application guide for Israel citizens traveling to the United States.",
  "url": "https://www.visaportal.online/countries/israel",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
